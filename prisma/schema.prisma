// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// GesContest – modelos do banco (PostgreSQL) a partir do DER v2
// ============================================================================

// ----------------------------- ENUMS ----------------------------------------
enum TipoUsuario {
  PROF
  ATLETA
  STAFF
  TECNICO
  ADM
}

enum FichaStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

enum Naipe {
  MASCULINO
  FEMININO
  MISTO
}

enum TipoModalidade {
  INDIVIDUAL
  COLETIVA
}

enum FormatoPlacar {
  CORRIDO
  SETS
  MARCA // tempo, distância ou peso (atletismo, natação, halterofilismo)
  LUTA  // judô, karatê, jiu-jitsu, taekwondo
}

enum FormaVitoria {
  IPPON
  PONTOS
  FINALIZACAO
  DECISAO
  WO
  DESCLASSIFICACAO
}

enum StatusDisputa {
  AGENDADA
  EM_ANDAMENTO
  ENCERRADA
  WO
  CANCELADA // jogo que sobrou numa série de play-off já decidida (automático)
  ANULADA   // partida anulada pelo coordenador (RN184)
}

enum StatusOcorrencia {
  ABERTA
  EM_ANALISE
  RESOLVIDA
}

enum StatusBoletim {
  RASCUNHO
  PUBLICADO
}

enum TipoBoletim {
  PARCIAL
  FINAL
}

// ----------------------------- USUÁRIO E DELEGAÇÃO --------------------------
model Usuario {
  id                Int          @id @default(autoincrement())
  tipo              TipoUsuario
  nome              String
  email             String       @unique
  celular           String?
  emailVerificado   Boolean      @default(false) @map("email_verificado") // Better Auth
  image             String? // Better Auth (foto; opcional)
  criadoEm          DateTime     @default(now()) @map("criado_em") // Better Auth
  atualizadoEm      DateTime     @updatedAt @map("atualizado_em") // Better Auth
  ultimoAcesso      DateTime?    @map("ultimo_acesso")
  cpf               String?      @unique // só ATLETA e STAFF
  matricula         String?      @unique // só ATLETA
  dataNascimento    DateTime?    @map("data_nascimento") @db.Date // só ATLETA
  fichaStatus       FichaStatus? @map("ficha_status") // só ATLETA
  fichaArquivo      String?      @map("ficha_arquivo") // só ATLETA
  fichaMotivoRecusa String?      @map("ficha_motivo_recusa") // NOVO: motivo da recusa (tela C6a)
  fichaEnviadaEm    DateTime?    @map("ficha_enviada_em") @db.Date // só ATLETA: dia em que a ficha começou a contar (RN110)
  fichaArquivoVisto String?      @map("ficha_arquivo_visto") // só ATLETA: ficha já anotada pela rotina diária
  precisaTrocarSenha Boolean     @default(false) @map("precisa_trocar_senha") // conta criada por outro usuário: troca a senha provisória no 1º acesso
  delegacaoId       Int?         @map("delegacao_id") // só TECNICO e ATLETA
  delegacao         Delegacao?   @relation("DelegacaoMembros", fields: [delegacaoId], references: [id])

  delegacoesCadastradas Delegacao[]          @relation("DelegacaoProf")
  notificacoes          Notificacao[]
  sessaos               Sessao[]
  eventosCoordenados    EventoCoordenador[]
  aprovacoesExclusao    EventoExclusaoAprovacao[]
  contas                Conta[]
  boletinsGerados       Boletim[]            @relation("BoletimAutor")
  boletinsPublicados    Boletim[]            @relation("BoletimPublicador")
  boletinsVistos        BoletimVisualizacao[]
  ocorrencias           Ocorrencia[]
  equipesCriadas        Equipe[]             @relation("EquipeCriador")
  equipesComoTecnico    Equipe[]             @relation("EquipeTecnico")
  equipesComoAtleta     EquipeAtleta[]
  resultados            Resultado[]
  dadoBancario          DadoBancario?
  acessosAosDados       AcessoDadoBancario[] @relation("AcessoAtleta")
  acessosFeitos         AcessoDadoBancario[] @relation("AcessoPor")
  impugnacoes           Impugnacao[]

  @@map("usuario")
}

// ----------------------------- LOGIN (Better Auth) --------------------------
// A senha (já com hash) fica em Conta.password. Estas 3 tabelas são do Better Auth:
// os nomes dos campos em inglês são os que a biblioteca espera.
model Sessao {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    Int
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessao")
}

model Conta {
  id                    Int       @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  usuario               Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("conta")
}

model Verificacao {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verificacao")
}

model Delegacao {
  id      Int       @id @default(autoincrement())
  nome    String
  profId  Int       @map("prof_id") // Prof/Coordenador que cadastrou
  prof    Usuario   @relation("DelegacaoProf", fields: [profId], references: [id])
  membros Usuario[] @relation("DelegacaoMembros")

  auxiliares Auxiliar[]
  equipes    Equipe[]

  @@map("delegacao")
}

model Auxiliar {
  id          Int       @id @default(autoincrement())
  nome        String
  celular     String?
  delegacaoId Int       @map("delegacao_id")
  delegacao   Delegacao @relation(fields: [delegacaoId], references: [id])

  equipes EquipeAuxiliar[]

  @@map("auxiliar")
}

model Notificacao {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagem     String
  dataHora     DateTime @default(now()) @map("data_hora")
  statusLida   Boolean  @default(false) @map("status_lida")
  emailEnviado Boolean  @default(false) @map("email_enviado")

  @@map("notificacao")
}

// ----------------------------- EVENTO, MODALIDADE, TORNEIO ------------------
model Evento {
  id            Int      @id @default(autoincrement())
  nome          String
  idadeLimite   Int?     @map("idade_limite") // conta só pelo ano de nascimento
  maxModTotal   Int?     @map("max_mod_total") // vazio = sem limite
  maxModInd     Int?     @map("max_mod_ind")
  maxModCol     Int?     @map("max_mod_col")
  dataInicio    DateTime @map("data_inicio")
  dataFim       DateTime @map("data_fim") 

  // RN151: prazo de inscrições (vazio = sem prazo definido, inscrições abertas até o início do evento)
  inscricaoInicio DateTime? @map("inscricao_inicio")
  inscricaoFim    DateTime? @map("inscricao_fim")

  // RN191/RN195: conferência das inscrições (facultativa) e prazo de recurso
  conferenciaInicio DateTime? @map("conferencia_inicio")
  conferenciaFim    DateTime? @map("conferencia_fim")
  recursoFim        DateTime? @map("recurso_fim")

  // RN150: atleta acima do limite de peso na pesagem sobe de categoria ou é eliminado dela
  pesoExcedente   PesoExcedente @default(SUBIR_CATEGORIA) @map("peso_excedente")

  // RN225: o coordenador decide se o evento pede dados bancários dos atletas (ex.: pagamento de bolsas)
  pedeDadosBancarios Boolean @default(false) @map("pede_dados_bancarios")

  locais       Local[]
  modalidades  Modalidade[]
  modalidadesMae ModalidadeMae[]
  boletins     Boletim[]
  coordenadores EventoCoordenador[]
  aprovacoesExclusao EventoExclusaoAprovacao[]
  periodos     PeriodoJogos[]
  regulamentos Regulamento[]
  impugnacoes Impugnacao[] 

  @@map("evento")
}


// Coordenadores do evento: um evento pode ter vários coordenadores e um
// coordenador pode coordenar vários eventos (muitos para muitos).
model EventoCoordenador {
  eventoId  Int     @map("evento_id")
  usuarioId Int     @map("usuario_id")
  evento    Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([eventoId, usuarioId])
  @@map("evento_coordenador")
}

// Aprovações para excluir um evento que tem mais de um coordenador: o evento só é
// excluído quando todos os coordenadores aprovam. Mudar os coordenadores zera o pedido.
model EventoExclusaoAprovacao {
  eventoId  Int      @map("evento_id")
  usuarioId Int      @map("usuario_id")
  criadoEm  DateTime @default(now()) @map("criado_em")
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([eventoId, usuarioId])
  @@map("evento_exclusao_aprovacao")
}

model Local {
  id       Int       @id @default(autoincrement())
  nome     String
  eventoId Int       @map("evento_id")
  evento   Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  disputas Disputa[]
  modalidades ModalidadeLocal[]
  @@map("local")
}

model Modalidade {
  id            Int            @id @default(autoincrement())
  eventoId      Int            @map("evento_id")
  evento        Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nome          String
  minAtletas    Int            @default(1) @map("min_atletas")
  maxAtletas    Int            @default(1) @map("max_atletas")
  minEquipes    Int            @default(2) @map("min_equipes") // RN167/RN168: abaixo disso o torneio só gera aviso
  tipo          TipoModalidade
  formatoPlacar FormatoPlacar? @map("formato_placar") // só modalidades com placar
  // RN182: só placar corrido, facultativo. PENALTIS ou PRORROGACAO_PENALTIS; vazio = o vencedor é informado à mão.
  desempateMataMata String?    @map("desempate_mata_mata")
  criteriosDesempate String[]  @map("criterios_desempate") // RN185: ordem dos critérios de classificação; vazio = padrão
  prorrogacaoMin    Int?       @map("prorrogacao_min")
  marcaMenorMelhor Boolean?    @map("marca_menor_melhor") // só formato MARCA: true = tempo, false = distância/peso

  // RN155: esta modalidade é uma PROVA de uma modalidade-mãe (ex.: Natação 100m na mãe "Natação").
  // Vazio = modalidade avulsa (ex.: Futsal), que conta por conta própria nos limites.
  maeId Int?            @map("mae_id")
  mae   ModalidadeMae?  @relation(fields: [maeId], references: [id], onDelete: Restrict)

  // RN157: só lutas. Como as categorias (torneios) são formadas: por peso e/ou idade e/ou faixa.
  catPeso   Boolean  @default(true)  @map("cat_peso")
  catIdade  Boolean  @default(false) @map("cat_idade")
  catFaixa  Boolean  @default(false) @map("cat_faixa")
  faixas    String[] // cores de faixa disponíveis na modalidade, da mais baixa à mais alta (só se catFaixa)

  torneios Torneio[]
  equipes  Equipe[]
  regulamentos Regulamento[]
  descansoEquipeMin Int  @default(30) @map("descanso_equipe_min") 
  // RN210: descanso mínimo entre dois jogos da mesma equipe (0 = sem descanso)
  locais            ModalidadeLocal[]

  @@map("modalidade")
}

// RN155/RN156: agrupa as provas de um mesmo esporte. Os limites de modalidades por atleta contam
// UMA vez por modalidade-mãe, e o tipo (individual/coletiva) usado na contagem vem daqui:
// tênis de mesa em duplas e revezamentos contam como individual quando a mãe é individual.
model ModalidadeMae {
  id       Int            @id @default(autoincrement())
  eventoId Int            @map("evento_id")
  evento   Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nome     String
  tipo     TipoModalidade // usado só na contagem dos limites do evento

  provas Modalidade[]
  regulamentos Regulamento[]

  @@unique([eventoId, nome])
  @@map("modalidade_mae")
}

model Torneio {
  id                  Int    @id @default(autoincrement())
  nome                String // NOVO: aparece na tela C3 ("Nome do torneio")
  modalidadeId        Int    @map("modalidade_id")
  modalidade          Modalidade @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)
  sistemaDisputa      String @map("sistema_disputa") // ex.: grupos, mata-mata, pontos corridos
  chaves              Int?
  pontosVit           Int    @default(3) @map("pontos_vit")
  pontosEmp           Int    @default(1) @map("pontos_emp")
  pontosDer           Int    @default(0) @map("pontos_der")
  setsParaVencer      Int?   @map("sets_para_vencer") // só modalidades por sets
  pontosPorSet        Int?   @map("pontos_por_set")
  pontosSetDecisivo   Int?   @map("pontos_set_decisivo")
  diferencaMinima     Int?   @map("diferenca_minima")
  woPlacarVencedor    Int?   @map("wo_placar_vencedor")
  woPlacarPerdedor    Int?   @map("wo_placar_perdedor")
  woPontosSetVencedor Int?   @map("wo_pontos_set_vencedor")
  pesoMin             Decimal? @map("peso_min") @db.Decimal(5, 2) // só lutas: faixa de peso da categoria (kg)
  pesoMax             Decimal? @map("peso_max") @db.Decimal(5, 2)
  // RN157: demais critérios da categoria (só valem se a modalidade os usa)
  naipe               Naipe?                       // vazio = sem separação por naipe
  idadeMin            Int?     @map("idade_min")   // idade pelo ano de nascimento (ano do evento − ano de nascimento)
  idadeMax            Int?     @map("idade_max")
  faixas              String[]                     // cores de faixa aceitas; vazio = todas
  turnos              Int     @default(1) // rodízio: 1 = turno simples, 2 = turno e returno
  variante            String? // eliminatório: SIMPLES ou REPESCAGEM
  classificadosPorGrupo Int?  @map("classificados_por_grupo") // misto: quantos de cada grupo avançam
  absoluto            Boolean  @default(false) // só lutas: sem limite de peso; participantes definidos no dia
  terceiroLugar       String?  @map("terceiro_lugar") // DISPUTA_3LUGAR, DOIS_BRONZES ou SEM_DISPUTA (sistemas eliminatórios)
  jogosPorSerie       Int?     @map("jogos_por_serie") // só play-off: série em melhor de 3, 5 ou 7
  jogosPorSerieFinal  Int?     @map("jogos_por_serie_final") // opcional: a final usa outro tamanho de série
  numTempos           Int?     @map("num_tempos") // só placar corrido: ex.: 2 tempos
  duracaoTempoMin     Int?     @map("duracao_tempo_min") // minutos de cada tempo (ex.: 15 no futsal escolar)
  intervaloTemposMin  Int?     @map("intervalo_tempos_min") // intervalo entre os tempos
  duracaoJogoMin      Int?     @map("duracao_jogo_min") // duração total estimada do jogo (calculada no corrido)
  intervaloJogosMin   Int      @default(10) @map("intervalo_jogos_min") // folga entre um jogo e o seguinte no mesmo local
  sorteioEm           DateTime? @map("sorteio_em") // quando os grupos/chaves foram sorteados

  disputas      Disputa[]
  participantes TorneioEquipe[]

  @@map("torneio")
}

// Quais equipes disputam cada torneio, com o grupo sorteado e a cabeça de chave (RN138).
// A mesma equipe pode estar em mais de um torneio (ex.: categoria de peso e absoluto).
model TorneioEquipe {
  torneioId     Int     @map("torneio_id")
  equipeId      Int     @map("equipe_id")
  torneio       Torneio @relation(fields: [torneioId], references: [id], onDelete: Cascade)
  equipe        Equipe  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  grupo         Int?    // número do grupo sorteado (só no sistema misto)
  cabecaDeChave Boolean @default(false) @map("cabeca_de_chave")
  posicao       Int?    // resultado do sorteio (RN166): posição na chave, ordem no rodízio ou ordem dentro do grupo
  desempateManual Int?  @map("desempate_manual") // RN185: ordem decidida à mão pelo coordenador quando os critérios não resolvem o empate

  @@id([torneioId, equipeId])
  @@map("torneio_equipe")
}

// Períodos do dia em que os jogos acontecem (manhã, tarde, noite), por evento (RN137).
model PeriodoJogos {
  id               Int    @id @default(autoincrement())
  eventoId         Int    @map("evento_id")
  evento           Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nome             String
  horaInicio       String @map("hora_inicio") // "HH:MM"
  horaFim          String @map("hora_fim")    // "HH:MM"
  maxJogosPorLocal Int?   @map("max_jogos_por_local") // vazio = quantos couberem

  @@map("periodo_jogos")
}

// ----------------------------- DISPUTAS (PARTIDA / PROVA) -------------------
model Disputa {
  id         Int           @id @default(autoincrement())
  torneioId  Int           @map("torneio_id")
  torneio    Torneio       @relation(fields: [torneioId], references: [id], onDelete: Cascade)
  localId    Int?          @map("local_id")
  local      Local?        @relation(fields: [localId], references: [id], onDelete: SetNull)
  dataHora   DateTime?     @map("data_hora") // vazio até a agenda distribuir os jogos (RN172)
  rodada     Int?          // rodízio e fases de mata-mata: ordem das rodadas
  numero     Int?          // "Jogo 5" dentro do torneio (usado para dizer "vencedor do jogo 5")
  duracaoMin Int?          @map("duracao_min")
  fase       String?
  serie       Int?         // play-off: número do confronto (série) a que o jogo pertence
  jogoNaSerie Int?         @map("jogo_na_serie") // play-off: jogo 1, 2, 3... da série
  motivoAnulacao String?   @map("motivo_anulacao") // só quando ANULADA
  status     StatusDisputa @default(AGENDADA)

  partida     Partida?
  prova       Prova?
  ocorrencias Ocorrencia[]
  travada Boolean @default(false) 
  // RN212: jogo fixado à mão; a agenda automática não mexe nele

  @@map("disputa")
}

model Partida {
  disputaId   Int     @id @map("disputa_id")
  disputa     Disputa @relation(fields: [disputaId], references: [id], onDelete: Cascade)
  // Em mata-mata, a vaga fica vazia até o jogo anterior terminar (origemAId/origemBId dizem qual).
  equipeAId   Int?    @map("equipe_a_id")
  equipeA     Equipe? @relation("PartidaEquipeA", fields: [equipeAId], references: [id], onDelete: Cascade)
  equipeBId   Int?    @map("equipe_b_id")
  equipeB     Equipe? @relation("PartidaEquipeB", fields: [equipeBId], references: [id], onDelete: Cascade)
  origemAId   Int?    @map("origem_a_id") // disputa de onde vem o vencedor (ou o perdedor) que ocupa a vaga A
  origemBId   Int?    @map("origem_b_id")
  origemPerdedor Boolean @default(false) @map("origem_perdedor") // true na disputa de 3º lugar
  // Mata-mata depois de grupos: a vaga espera o classificado em tal posição de tal grupo (ex.: 1º do grupo 2).
  origemGrupoA Int? @map("origem_grupo_a")
  origemPosA   Int? @map("origem_pos_a")
  origemGrupoB Int? @map("origem_grupo_b")
  origemPosB   Int? @map("origem_pos_b")
  placarA     Int?    @default(0) @map("placar_a") // nas lutas, opcional (pontos ou rounds)
  placarB     Int?    @default(0) @map("placar_b")
  vencedorId  Int?    @map("vencedor_id") // usado nas lutas, onde o placar pode não existir
  vencedor    Equipe? @relation("PartidaVencedor", fields: [vencedorId], references: [id], onDelete: SetNull)
  formaVitoria FormaVitoria? @map("forma_vitoria") // só lutas
  cartaoAmaA  Int     @default(0) @map("cartao_ama_a")
  cartaoAmaB  Int     @default(0) @map("cartao_ama_b")
  cartaoVerA  Int     @default(0) @map("cartao_ver_a")
  cartaoVerB  Int     @default(0) @map("cartao_ver_b")
  decididoPor String? @map("decidido_por") // TEMPO_NORMAL, PRORROGACAO, PENALTIS ou MANUAL (mata-mata de placar corrido)
  penaltisA   Int?    @map("penaltis_a")
  penaltisB   Int?    @map("penaltis_b")
  woEquipeId  Int?    @map("wo_equipe_id") // equipe que deu WO
  woEquipe    Equipe? @relation("PartidaWo", fields: [woEquipeId], references: [id], onDelete: SetNull)

  sets SetPartida[]

  @@map("partida")
}

model SetPartida {
  partidaId Int     @map("partida_id")
  numero    Int
  pontosA   Int     @default(0) @map("pontos_a")
  pontosB   Int     @default(0) @map("pontos_b")
  partida   Partida @relation(fields: [partidaId], references: [disputaId], onDelete: Cascade)

  @@id([partidaId, numero])
  @@map("set_partida")
}

model Prova {
  disputaId Int     @id @map("disputa_id")
  disputa   Disputa @relation(fields: [disputaId], references: [id], onDelete: Cascade)
  bateria   Int?

  resultados Resultado[]

  @@map("prova")
}

// Resultado de prova: OU atleta OU equipe (regra XOR – ver o SQL de CHECK no fim do arquivo)
model Resultado {
  id        Int      @id @default(autoincrement())
  provaId   Int      @map("prova_id")
  prova     Prova    @relation(fields: [provaId], references: [disputaId], onDelete: Cascade)
  atletaId  Int?     @map("atleta_id")
  atleta    Usuario? @relation(fields: [atletaId], references: [id])
  equipeId  Int?     @map("equipe_id")
  equipe    Equipe?  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  unidade   String? // ex.: s, m
  colocacao Int?
  marca     Float?

  @@map("resultado")
}

// RN175, RN177, RN190: regulamento em PDF (arquivo no armazenamento privado; o sistema abre para o público).
// Escopo: geral do evento (maeId e modalidadeId vazios), de uma modalidade-mãe (maeId) ou de uma modalidade avulsa (modalidadeId).
model Regulamento {
  id           Int            @id @default(autoincrement())
  eventoId     Int            @map("evento_id")
  evento       Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  maeId        Int?           @map("mae_id")
  mae          ModalidadeMae? @relation(fields: [maeId], references: [id], onDelete: Cascade)
  modalidadeId Int?           @map("modalidade_id")
  modalidade   Modalidade?    @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)
  chave        String         // caminho do arquivo no armazenamento
  nomeArquivo  String         @map("nome_arquivo")
  tamanho      Int
  enviadoEm    DateTime       @default(now()) @map("enviado_em")

  @@index([eventoId])
  @@map("regulamento")
}

// ----------------------------- EQUIPES --------------------------------------
model Equipe {
  id           Int        @id @default(autoincrement())
  delegacaoId  Int        @map("delegacao_id")
  delegacao    Delegacao  @relation(fields: [delegacaoId], references: [id])
  nome         String
  naipe        Naipe
  modalidadeId Int        @map("modalidade_id")
  modalidade   Modalidade @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)
  criadorId    Int        @map("criador_id") // Chefe de Delegação que criou (RN146)
  criador      Usuario    @relation("EquipeCriador", fields: [criadorId], references: [id])
  tecnicoId    Int?       @map("tecnico_id") // responsável; vincula-se depois da criação
  tecnico      Usuario?   @relation("EquipeTecnico", fields: [tecnicoId], references: [id])

  atletas     EquipeAtleta[]
  auxiliares  EquipeAuxiliar[]
  partidasA   Partida[]  @relation("PartidaEquipeA")
  partidasB   Partida[]  @relation("PartidaEquipeB")
  partidasWo  Partida[]  @relation("PartidaWo")
  vitorias    Partida[]  @relation("PartidaVencedor")
  resultados  Resultado[]
  torneios    TorneioEquipe[]

  @@unique([id, modalidadeId]) // necessário para a chave composta de EquipeAtleta
  @@map("equipe")
}

// Um atleta pode estar em várias equipes, mas só em UMA por modalidade.
model EquipeAtleta {
  atletaId     Int     @map("atleta_id")
  equipeId     Int     @map("equipe_id")
  modalidadeId Int     @map("modalidade_id") // repete a modalidade da equipe, de propósito
  pesoKg       Decimal? @map("peso_kg") @db.Decimal(5, 2) // só lutas: informado na inscrição
  pesoConfirmado Boolean @default(false) @map("peso_confirmado") // Staff confirma na pesagem oficial
  faixa          String? // só lutas com categoria por faixa: informada na inscrição (Staff pode corrigir na pesagem)
  atleta       Usuario @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  equipe       Equipe  @relation(fields: [equipeId, modalidadeId], references: [id, modalidadeId], onDelete: Cascade)

  @@id([atletaId, equipeId])
  @@unique([atletaId, modalidadeId])
  @@map("equipe_atleta")
}

model EquipeAuxiliar {
  auxiliarId Int      @map("auxiliar_id")
  equipeId   Int      @map("equipe_id")
  auxiliar   Auxiliar @relation(fields: [auxiliarId], references: [id], onDelete: Cascade)
  equipe     Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@id([auxiliarId, equipeId])
  @@map("equipe_auxiliar")
}

// ----------------------------- OCORRÊNCIA E BOLETIM -------------------------
model Ocorrencia {
  id        Int              @id @default(autoincrement())
  usuarioId Int              @map("usuario_id") // quem reportou
  usuario   Usuario          @relation(fields: [usuarioId], references: [id])
  disputaId Int              @map("disputa_id")
  disputa   Disputa          @relation(fields: [disputaId], references: [id], onDelete: Cascade)
  tipo      String
  descricao String
  dataHora  DateTime         @default(now()) @map("data_hora")
  status    StatusOcorrencia @default(ABERTA)

  @@map("ocorrencia")
}

model Boletim {
  id               Int           @id @default(autoincrement())
  eventoId         Int           @map("evento_id")
  evento           Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuarioId        Int           @map("usuario_id") // quem gerou
  usuario          Usuario       @relation("BoletimAutor", fields: [usuarioId], references: [id])
  nome             String
  dataGeracao      DateTime      @default(now()) @map("data_geracao") @db.Date
  dataPublicacao   DateTime?     @map("data_publicacao") @db.Date
  tipo             TipoBoletim
  caminhoArquivo   String?       @map("caminho_arquivo")
  criteriosAplicados String?     @map("criterios_aplicados")
  status           StatusBoletim @default(RASCUNHO)
  publicadoPorId   Int?          @map("publicado_por_id")
  publicadoPor     Usuario?      @relation("BoletimPublicador", fields: [publicadoPorId], references: [id])

  dia      String?  // boletim diário: "2026-11-21"; vazio no boletim final
  conteudo Json?    // o boletim fica "congelado" como foi gerado (RN219)

  visualizacoes BoletimVisualizacao[]

  @@map("boletim")
}

model BoletimVisualizacao {
  boletimId Int      @map("boletim_id")
  usuarioId Int      @map("usuario_id")
  boletim   Boletim  @relation(fields: [boletimId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([boletimId, usuarioId])
  @@map("boletim_visualizacao")
}

// ============================================================================
// REGRA QUE O PRISMA NÃO EXPRESSA (adicionar depois, no SQL da migração):
//   ALTER TABLE resultado ADD CONSTRAINT resultado_atleta_xor_equipe
//     CHECK ((atleta_id IS NULL) <> (equipe_id IS NULL));
// ============================================================================

enum PesoExcedente {
  SUBIR_CATEGORIA
  ELIMINAR
}

enum StatusImpugnacao {
  IMPUGNADO        // coordenador impugnou; aguarda recurso ou decisão (pendente)
  RECURSO_ENVIADO  // chefe de delegação enviou o recurso; aguarda decisão (pendente)
  DEFERIDO         // a inscrição volta a valer
  INDEFERIDO       // a inscrição é cancelada (inclui o bloqueio)
}

model Impugnacao {
  id       Int     @id @default(autoincrement())
  eventoId Int     @map("evento_id")
  evento   Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  atletaId Int     @map("atleta_id")
  atleta   Usuario @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  status   StatusImpugnacao @default(IMPUGNADO)
  bloqueio Boolean          @default(false) // RN198: decisão final, sem recurso
  motivo   String
  criadoEm DateTime         @default(now()) @map("criado_em")
  criadoPorId Int           @map("criado_por_id")

  recursoTexto       String?   @map("recurso_texto")
  recursoArquivo     String?   @map("recurso_arquivo") // chave do PDF no storage privado
  recursoNomeArquivo String?   @map("recurso_nome_arquivo")
  recursoEm          DateTime? @map("recurso_em")
  recursoPorId       Int?      @map("recurso_por_id")

  decisaoTexto String?   @map("decisao_texto")
  decididoPorId Int?     @map("decidido_por_id")
  decididoEm   DateTime? @map("decidido_em")

  @@unique([eventoId, atletaId])
  @@map("impugnacao")
}

// RN209: quais locais servem a cada modalidade. Modalidade sem nenhum local marcado aceita qualquer local.
  model ModalidadeLocal {
  modalidadeId Int        @map("modalidade_id")
  localId      Int        @map("local_id")
  modalidade   Modalidade @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)
  local        Local      @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@id([modalidadeId, localId])
  @@map("modalidade_local")
}

enum TipoConta {
  CORRENTE
  POUPANCA

  @@map("tipo_conta")
}

// RN225-RN232: dados bancários do atleta. Agência, conta e titular ficam CIFRADOS (AES-256-GCM);
// o banco e o tipo da conta não identificam ninguém sozinhos e ficam em texto.
model DadoBancario {
  usuarioId      Int       @id @map("usuario_id")
  banco          String
  tipoConta      TipoConta @map("tipo_conta")
  agenciaCifrada String    @map("agencia_cifrada")
  contaCifrada   String    @map("conta_cifrada")
  titularCifrado String    @map("titular_cifrado")
  informadoEm    DateTime  @map("informado_em") @db.Date // data do envio: base da exclusão automática
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("dado_bancario")
}

// RN231: registro de quem viu os dados completos de um atleta, e quando (sem guardar os dados).
model AcessoDadoBancario {
  id            Int      @id @default(autoincrement())
  atletaId      Int      @map("atleta_id")
  acessadoPorId Int      @map("acessado_por_id")
  eventoId      Int?     @map("evento_id")
  em            DateTime @default(now())
  atleta        Usuario  @relation("AcessoAtleta", fields: [atletaId], references: [id], onDelete: Cascade)
  acessadoPor   Usuario  @relation("AcessoPor", fields: [acessadoPorId], references: [id], onDelete: Cascade)

  @@index([atletaId])
  @@map("acesso_dado_bancario")
}